include LICENSE *.md
recursive-include mujoco *.h *.cc *.cc.inc *.cpp *.inl *.html *.mm CMakeLists.txt *.cmake
recursive-include mujoco/doc *.rst *.md
recursive-include mujoco/mjpython mjpython.* Info.plist
prune mujoco/simulate/build*
prune mujoco/simulate/cmake-build*
prune mujoco_full
prune studio
prune mujoco/mujoco_full
prune mujoco/sample/studio
prune mujoco/studio
exclude mujoco/render_filament.cc mujoco/render_filament.h
