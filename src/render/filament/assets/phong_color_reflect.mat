material {
    name : phong_color_reflect,
    shadingModel : specularGlossiness,
    postLightingBlending : add,
    parameters : [
        { type : float4, name : BaseColorFactor },
        { type : float, name : SpecularFactor },
        { type : float, name : GlossinessFactor },
        { type : float, name : EmissiveFactor },
        { type : float, name : Reflectance },
        { type : float3, name : ReflectionNormal },
        { type : mat4, name : ReflectionViewProj },
        { type : sampler2d, name : Reflection }
    ]
}

fragment {
  void material(inout MaterialInputs material) {
    prepareMaterial(material);
    material.baseColor     = materialParams.BaseColorFactor;
    material.specularColor = vec3(materialParams.SpecularFactor);
    material.glossiness    = materialParams.GlossinessFactor;
    material.emissive      = vec4(
        materialParams.BaseColorFactor.rgb * materialParams.EmissiveFactor, 0.0);

    // Planar reflection: Fresnel-weighted additive post-lighting.
    vec4 refl_clip = materialParams.ReflectionViewProj * vec4(getUserWorldPosition(), 1.0);
    vec2 refl_uv = uvToRenderTargetUV(refl_clip.xy / refl_clip.w * 0.5 + 0.5);
    vec3 reflection = texture(materialParams_Reflection, refl_uv).rgb;
    float f0 = materialParams.Reflectance;
    float fresnel = f0 + (1.0 - f0) * pow(1.0 - getNdotV(), 5.0);
    float front =
        dot(materialParams.ReflectionNormal, materialParams.ReflectionNormal) < 0.5
            ? 1.0  // planes bypass the front-face gate
            : step(0.99, dot(getWorldGeometricNormalVector(),
                             materialParams.ReflectionNormal));
    material.postLightingColor = vec4(reflection * fresnel * front, 0.0);
  }
}
