load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

package(default_visibility = ["//:__subpackages__"])

cc_library(
    name = "glad",
    srcs = [
        "glad/glad.c",
        "glad/loader.cc",
    ],
    hdrs = ["glad/glad.h"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkopts = ["-ldl"],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    deps = ["//src/engine:engine_util_errmem"],
)

cc_library(
    name = "classic",
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    deps = [
        ":render_context",
        ":render_gl2",
        ":render_gl3",
        ":render_util",
        "//:libmujoco_hdrs",
    ],
)

_C_CONLYOPTS = [
    "-std=c11",
    "-Werror",
    "-Wall",
    "-Wpedantic",
    "-Wstrict-prototypes",
    "-Wunused",
    "-Wvla",
    "-Wimplicit-fallthrough",
]

cc_library(
    name = "render_context",
    srcs = ["render_context.c"],
    hdrs = ["render_context.h"],
    conlyopts = _C_CONLYOPTS + ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    textual_hdrs = glob([
        "font/*.inc",
    ]),
    deps = [
        ":glad",
        ":render_util",
        "//:libmujoco_hdrs",
        "//src/user:user_model",  # buildcleaner: keep
    ],
)

cc_library(
    name = "render_gl2",
    srcs = ["render_gl2.c"],
    hdrs = ["render_gl2.h"],
    conlyopts = _C_CONLYOPTS + ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    deps = [
        ":glad",
        "//:libmujoco_hdrs",
        "//src/engine:engine_array_safety",
    ],
)

cc_library(
    name = "render_gl3",
    srcs = ["render_gl3.c"],
    hdrs = ["render_gl3.h"],
    conlyopts = _C_CONLYOPTS + ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
        "mjUSEPLATFORMSIMD",
    ],
    deps = [
        ":glad",
        ":render_context",
        ":render_gl2",
        ":render_util",
        "//:libmujoco_hdrs",
        "//src/engine:engine_sort",
        "//src/engine:engine_vis",  # buildcleaner: keep
        "//src/engine:engine_vis_init",
    ],
)

cc_library(
    name = "render_util",
    srcs = ["render_util.c"],
    hdrs = ["render_util.h"],
    conlyopts = _C_CONLYOPTS + ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    deps = [
        ":glad",
        "//:libmujoco_hdrs",
    ],
)
